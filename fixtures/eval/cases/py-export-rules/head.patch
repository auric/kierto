@@ -0,0 +1,63 @@
+import csv
+import io
+import json
+import sqlite3
+
+import pytest
+
+from app import config
+from app.exporter import csv_lines, jsonl_lines, write_export
+from app.handlers.export import export_accounts
+
+
+@pytest.fixture
+def accounts_db(tmp_path):
+    path = tmp_path / "accounts.db"
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE accounts (id INTEGER PRIMARY KEY, email TEXT, name TEXT, created_at TEXT, deleted_at TEXT)")
+    conn.executemany(
+        "INSERT INTO accounts (id, email, name, created_at) VALUES (?, ?, ?, ?)",
+        [(1, "ana@example.test", "Ana, Jr.", "2026-01-02"), (2, "bo@example.test", 'Bo "B" Lee', "2026-02-03")],
+    )
+    conn.commit()
+    conn.close()
+    config.set_tenant("test", {"DB_PATH": str(path)})
+    yield path
+    config.set_tenant("default")
+
+
+ROWS = [{"id": 1, "email": "ana@example.test", "name": "Ana, Jr.", "created_at": "2026-01-02"}]
+
+
+def test_csv_quotes_commas_and_quotes():
+    text = "".join(csv_lines(ROWS + [{"id": 2, "email": "b@example.test", "name": 'Bo "B"', "created_at": "x"}]))
+    assert list(csv.reader(io.StringIO(text)))[1:] == [
+        ["1", "ana@example.test", "Ana, Jr.", "2026-01-02"],
+        ["2", "b@example.test", 'Bo "B"', "x"],
+    ]
+
+
+def test_csv_of_no_rows_has_the_header():
+    assert "".join(csv_lines([])).strip() == "id,email,name,created_at"
+
+
+def test_jsonl_has_one_object_per_line():
+    lines = list(jsonl_lines(ROWS))
+    assert [json.loads(line)["name"] for line in lines] == ["Ana, Jr."]
+
+
+def test_handler_refuses_an_unknown_format(accounts_db):
+    assert export_accounts({"format": "xml"})[0] == 400
+
+
+def test_handler_exports_csv(accounts_db):
+    status, body = export_accounts({})
+    assert status == 200
+    assert body["rows"] == 2
+    assert body["content_type"].startswith("text/csv")
+
+
+def test_write_export_writes_a_file(accounts_db, tmp_path):
+    out = tmp_path / "out.jsonl"
+    write_export([dict(ROWS[0])], str(out), "jsonl")
+    assert json.loads(out.read_text(encoding="utf-8"))["id"] == 1
