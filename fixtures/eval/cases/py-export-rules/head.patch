diff --git a/app/exporter.py b/app/exporter.py
new file mode 100644
index 0000000..e2208af
--- /dev/null
+++ b/app/exporter.py
@@ -0,0 +1,47 @@
+"""The account export as CSV or JSON Lines. The CLI and the HTTP handler share it."""
+
+import csv
+import io
+import json
+from collections.abc import Iterable, Iterator
+
+from app.db import query
+
+COLUMNS = ("id", "email", "name", "created_at")
+
+
+def fetch_accounts(limit: int | None = None) -> list[dict]:
+    sql = "SELECT id, email, name, created_at FROM accounts ORDER BY id"
+    if limit is not None:
+        return query(sql + " LIMIT ?", (limit,))
+    return query(sql)
+
+
+def _take(buf: io.StringIO) -> str:
+    value = buf.getvalue()
+    buf.seek(0)
+    buf.truncate()
+    return value
+
+
+def csv_lines(rows: Iterable[dict]) -> Iterator[str]:
+    """The header line, then one CSV line per row."""
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(COLUMNS)
+    yield _take(buf)
+    for row in rows:
+        writer.writerow([row[c] for c in COLUMNS])
+        yield _take(buf)
+
+
+def jsonl_lines(rows: Iterable[dict]) -> Iterator[str]:
+    """One JSON object per row and line."""
+    for row in rows:
+        yield json.dumps({c: row[c] for c in COLUMNS}, ensure_ascii=False) + "\n"
+
+
+def write_export(rows: list[dict], path: str, fmt: str) -> None:
+    lines = csv_lines(rows) if fmt == "csv" else jsonl_lines(rows)
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        f.writelines(lines)
diff --git a/app/handlers/export.py b/app/handlers/export.py
new file mode 100644
index 0000000..1dff064
--- /dev/null
+++ b/app/handlers/export.py
@@ -0,0 +1,19 @@
+import os
+
+from app.exporter import csv_lines, fetch_accounts, jsonl_lines
+
+FORMATS = {
+    "csv": ("text/csv; charset=utf-8", csv_lines),
+    "jsonl": ("application/x-ndjson", jsonl_lines),
+}
+
+
+def export_accounts(params: dict[str, str]) -> tuple[int, dict]:
+    """GET /accounts/export?format=csv for the finance team."""
+    fmt = params.get("format", "csv")
+    if fmt not in FORMATS:
+        return 400, {"error": "format must be csv or jsonl"}
+    max_rows = int(os.environ.get("EXPORT_MAX_ROWS", "100000"))
+    rows = fetch_accounts(limit=max_rows)
+    content_type, lines = FORMATS[fmt]
+    return 200, {"content_type": content_type, "body": "".join(lines(rows)), "rows": len(rows)}
