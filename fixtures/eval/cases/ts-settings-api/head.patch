@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import { settingsApi } from "../../src/api/settings";
+import type { Request } from "../../src/http";
+import { DEFAULTS, type Section, type Settings } from "../../src/settings/model";
+import type { SettingsStore } from "../../src/settings/store";
+
+function fakeStore() {
+  const s: Settings = structuredClone(DEFAULTS);
+  const store = {
+    get: async () => structuredClone(s),
+    save: async (section: Section, update: Record<string, unknown>) => {
+      Object.assign(s[section], update);
+      return structuredClone(s);
+    },
+  };
+  return { store: store as unknown as SettingsStore, s };
+}
+
+const admin = { id: "a1", admin: true };
+const req = (body: unknown, user: Request["user"] = admin, params: Record<string, string> = {}): Request => ({
+  params,
+  query: {},
+  body,
+  user,
+});
+
+describe("settings API", () => {
+  it("returns all settings", async () => {
+    const { store } = fakeStore();
+    const res = await settingsApi(store).getAll(req(undefined, null));
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({ siteName: "Build Board", timeoutMs: 30_000, limits: { maxProjects: 50 } });
+  });
+
+  it("returns one section", async () => {
+    const { store } = fakeStore();
+    const res = await settingsApi(store).getSection(req(undefined, null, { section: "limits" }));
+    expect(res.body).toEqual(DEFAULTS.limits);
+  });
+
+  it("refuses a change by a user who is not an admin", async () => {
+    const { store, s } = fakeStore();
+    const api = settingsApi(store);
+    for (const put of [api.putGeneral, api.putDelivery, api.putNotifications, api.putLimits]) {
+      expect((await put(req({}, { id: "u1", admin: false }))).status).toBe(403);
+    }
+    expect(s).toEqual(DEFAULTS);
+  });
+
+  it("validates the delivery values", async () => {
+    const { store } = fakeStore();
+    const res = await settingsApi(store).putDelivery(req({ retries: 50 }));
+    expect(res.status).toBe(400);
+  });
+
+  it("saves the limits", async () => {
+    const { store, s } = fakeStore();
+    const res = await settingsApi(store).putLimits(req({ maxProjects: 80 }));
+    expect(res.status).toBe(200);
+    expect(s.limits.maxProjects).toBe(80);
+  });
+
+  it("saves quiet hours and the channel", async () => {
+    const { store, s } = fakeStore();
+    await settingsApi(store).putNotifications(req({ channel: "chat", quietHours: { from: "22:00", to: "07:00" } }));
+    expect(s.notifications).toEqual({ onFailure: true, channel: "chat", quietHours: { from: "22:00", to: "07:00" } });
+  });
+});
