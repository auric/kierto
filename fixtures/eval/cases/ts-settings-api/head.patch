@@ -0,0 +1,89 @@
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import type { SettingsRows } from "../../src/db";
+import { DEFAULTS } from "../../src/settings/model";
+import { fromFlat, SettingsStore } from "../../src/settings/store";
+
+function memoryRows(initial: Record<string, Record<string, unknown>> = {}) {
+  const data = structuredClone(initial);
+  let reads = 0;
+  const rows: SettingsRows = {
+    all: async () => {
+      reads++;
+      return structuredClone(data);
+    },
+    save: async (section, value) => {
+      data[section] = structuredClone(value);
+    },
+  };
+  return { rows, data, reads: () => reads };
+}
+
+function overridesFile(content: unknown) {
+  const dir = mkdtempSync(join(tmpdir(), "settings-"));
+  const path = join(dir, "overrides.json");
+  writeFileSync(path, JSON.stringify(content));
+  return path;
+}
+
+describe("fromFlat", () => {
+  it("maps the flat keys of the old config to sections", () => {
+    expect(fromFlat({ retryLimit: 5, notifyChannel: "chat", unknown: 1 })).toEqual({
+      delivery: { retries: 5 },
+      notifications: { channel: "chat" },
+    });
+  });
+
+  it("ignores inherited names and non-objects", () => {
+    expect(fromFlat(JSON.parse('{"__proto__": {"x": 1}, "toString": 2}'))).toEqual({});
+    expect(fromFlat(null)).toEqual({});
+    expect(fromFlat("text")).toEqual({});
+  });
+});
+
+describe("SettingsStore", () => {
+  it("layers the defaults, the overrides file, and the saved rows", async () => {
+    const { rows } = memoryRows({ general: { siteName: "Saved name" } });
+    const store = new SettingsStore(rows, { overridesPath: overridesFile({ siteName: "File name", maxProjects: 9 }) });
+    const s = await store.get();
+    expect(s.general.siteName).toBe("Saved name");
+    expect(s.limits.maxProjects).toBe(9);
+    expect(s.delivery).toEqual(DEFAULTS.delivery);
+  });
+
+  it("drops unknown columns of a saved row", async () => {
+    const { rows } = memoryRows({ limits: { maxProjects: 3, legacy: true } });
+    const store = new SettingsStore(rows, { overridesPath: overridesFile({}) });
+    expect(await store.get()).toMatchObject({ limits: { maxUploadMb: 20, maxProjects: 3 } });
+    expect((await store.get()).limits).not.toHaveProperty("legacy");
+  });
+
+  it("reuses a read within the cache time", async () => {
+    let t = 0;
+    const m = memoryRows();
+    const store = new SettingsStore(m.rows, { overridesPath: overridesFile({}), cacheMs: 100, now: () => t });
+    await store.get();
+    t = 99;
+    await store.get();
+    expect(m.reads()).toBe(1);
+    t = 100;
+    await store.get();
+    expect(m.reads()).toBe(2);
+  });
+
+  it("returns a copy, so a caller cannot change the cached value", async () => {
+    const store = new SettingsStore(memoryRows().rows, { overridesPath: overridesFile({}) });
+    (await store.get()).general.siteName = "changed";
+    expect((await store.get()).general.siteName).toBe(DEFAULTS.general.siteName);
+  });
+
+  it("saves a whole section and reads it back", async () => {
+    const m = memoryRows();
+    const store = new SettingsStore(m.rows, { overridesPath: overridesFile({ timeoutMs: 5_000 }) });
+    const s = await store.save("delivery", { retries: 7 });
+    expect(s.delivery).toEqual({ retries: 7, timeoutMs: 5_000 });
+    expect(m.data.delivery).toEqual({ retries: 7, timeoutMs: 5_000 });
+  });
+});
