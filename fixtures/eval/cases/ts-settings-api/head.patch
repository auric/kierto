+import type { Settings } from "./model";
+
+// The body of GET /v1/settings and of each PUT /v1/settings/... response.
+export function toV1(s: Settings) {
+  return {
+    siteName: s.general.siteName,
+    supportEmail: s.general.supportEmail,
+    retries: s.delivery.retries,
+    timeoutMs: s.delivery.timeoutMs,
+    notifications: {
+      onFailure: s.notifications.onFailure,
+      channel: s.notifications.channel,
+      quietHours: s.notifications.quietHours,
+    },
+    limits: {
+      maxUploadMb: s.limits.maxUploadMb,
+      maxProjects: s.limits.maxProjects,
+    },
+  };
+}
diff --git a/src/settings/store.ts b/src/settings/store.ts
new file mode 100644
index 0000000..67d7970
--- /dev/null
+++ b/src/settings/store.ts
@@ -0,0 +1,81 @@
+import { readFile } from "node:fs/promises";
+import type { SettingsRows } from "../db";
+import { DEFAULTS, type Section, SECTIONS, type Settings } from "./model";
+
+type Layer = Partial<Record<Section, Record<string, unknown>>>;
+
+// config/overrides.json keeps the flat keys of the old config module. The settings table uses sections.
+const FLAT: Record<string, [Section, string]> = {
+  siteName: ["general", "siteName"],
+  supportEmail: ["general", "supportEmail"],
+  retryLimit: ["delivery", "retries"],
+  timeoutMs: ["delivery", "timeoutMs"],
+  notifyOnFailure: ["notifications", "onFailure"],
+  notifyChannel: ["notifications", "channel"],
+  maxUploadMb: ["limits", "maxUploadMb"],
+  maxProjects: ["limits", "maxProjects"],
+};
+
+export function fromFlat(flat: unknown): Layer {
+  const out: Layer = {};
+  if (typeof flat !== "object" || flat === null) return out;
+  for (const [key, value] of Object.entries(flat)) {
+    if (!Object.hasOwn(FLAT, key)) continue;
+    const [section, field] = FLAT[key] as [Section, string];
+    (out[section] ??= {})[field] = value;
+  }
+  return out;
+}
+
+// Copies only the known fields of each section, so a stale column in the table cannot add keys.
+function apply(base: Settings, layer: Layer): Settings {
+  for (const section of SECTIONS) {
+    const part = layer[section];
+    if (!part) continue;
+    const target = base[section] as Record<string, unknown>;
+    for (const key of Object.keys(target)) if (Object.hasOwn(part, key)) target[key] = part[key];
+  }
+  return base;
+}
+
+export type StoreOptions = {
+  overridesPath?: string;
+  // Reads within this time reuse the last result.
+  cacheMs?: number;
+  now?: () => number;
+};
+
+export class SettingsStore {
+  private cached: { value: Settings; at: number } | null = null;
+  private readonly overridesPath: string;
+  private readonly cacheMs: number;
+  private readonly now: () => number;
+
+  constructor(
+    private readonly rows: SettingsRows,
+    options: StoreOptions = {},
+  ) {
+    this.overridesPath = options.overridesPath ?? "config/overrides.json";
+    this.cacheMs = options.cacheMs ?? 5_000;
+    this.now = options.now ?? Date.now;
+  }
+
+  async get(): Promise<Settings> {
+    if (this.cached && this.now() - this.cached.at < this.cacheMs) return structuredClone(this.cached.value);
+    const value = apply(apply(structuredClone(DEFAULTS), await this.overrides()), (await this.rows.all()) as Layer);
+    this.cached = { value, at: this.now() };
+    return structuredClone(value);
+  }
+
+  async save<S extends Section>(section: S, update: Partial<Settings[S]>): Promise<Settings> {
+    const current = await this.get();
+    await this.rows.save(section, { ...current[section], ...update });
+    this.cached = null;
+    return this.get();
+  }
+
+  private async overrides(): Promise<Layer> {
+    const text = await readFile(this.overridesPath, "utf8");
+    return fromFlat(JSON.parse(text));
+  }
+}
