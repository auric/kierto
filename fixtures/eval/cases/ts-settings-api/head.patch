+export const SECTIONS = ["general", "delivery", "notifications", "limits"] as const;
+export type Section = (typeof SECTIONS)[number];
+
+export const CHANNELS = ["email", "chat", "none"] as const;
+export type Channel = (typeof CHANNELS)[number];
+
+export type GeneralSettings = {
+  siteName: string;
+  supportEmail: string;
+};
+
+export type DeliverySettings = {
+  // Attempts after the first failed one.
+  retries: number;
+  timeoutMs: number;
+};
+
+export type QuietHours = { from: string; to: string };
+
+export type NotificationSettings = {
+  onFailure: boolean;
+  channel: Channel;
+  // Local time HH:MM. No message goes out between from and to.
+  quietHours: QuietHours | null;
+};
+
+export type LimitSettings = {
+  maxUploadMb: number;
+  maxProjects: number;
+};
+
+export type Settings = {
+  general: GeneralSettings;
+  delivery: DeliverySettings;
+  notifications: NotificationSettings;
+  limits: LimitSettings;
+};
+
+export const DEFAULTS: Settings = {
+  general: { siteName: "Build Board", supportEmail: "support@example.test" },
+  delivery: { retries: 3, timeoutMs: 30_000 },
+  notifications: { onFailure: true, channel: "email", quietHours: null },
+  limits: { maxUploadMb: 20, maxProjects: 50 },
+};
+
+export const isSection = (s: string): s is Section => (SECTIONS as readonly string[]).includes(s);
