@@ -0,0 +1,89 @@
+"""Downloads a list of URLs with a few worker threads."""
+
+import logging
+import queue
+import shutil
+import threading
+from dataclasses import dataclass, field
+from pathlib import Path
+from urllib.request import urlopen
+
+from fetcher.naming import safe_name
+
+log = logging.getLogger(__name__)
+CHUNK = 64 * 1024
+ALLOWED_TYPES = {"application/pdf", "application/zip"}
+
+
+@dataclass
+class DownloadReport:
+    saved: list[Path] = field(default_factory=list)
+    skipped: list[str] = field(default_factory=list)
+    failed: dict[str, str] = field(default_factory=dict)
+
+
+class ParallelDownloader:
+    def __init__(self, dest: Path, workers: int = 4, timeout: float = 30.0, opener=urlopen):
+        if workers < 1:
+            raise ValueError("workers must be at least 1")
+        self.dest = dest
+        self.workers = workers
+        self.timeout = timeout
+        self._open = opener
+        self._lock = threading.Lock()
+        self._done = threading.Event()
+        self._report = DownloadReport()
+        self._total = 0
+        self.completed = 0
+
+    def run(self, urls: list[str]) -> DownloadReport:
+        """Downloads each URL and returns when every URL is done. Use one downloader per run."""
+        if not urls:
+            return DownloadReport()
+        self._total = len(urls)
+        jobs: queue.Queue[str] = queue.Queue()
+        for url in urls:
+            jobs.put(url)
+        for _ in range(min(self.workers, len(urls))):
+            threading.Thread(target=self._worker, args=(jobs,), daemon=True).start()
+        self._done.wait()
+        with self._lock:
+            return DownloadReport(list(self._report.saved), list(self._report.skipped), dict(self._report.failed))
+
+    def _worker(self, jobs: "queue.Queue[str]") -> None:
+        while True:
+            try:
+                url = jobs.get_nowait()
+            except queue.Empty:
+                return
+            try:
+                path = self._fetch(url)
+                with self._lock:
+                    self._record(url, path, None)
+            except Exception as e:
+                log.warning("download of %s failed: %s", url, e)
+                with self._lock:
+                    self._record(url, None, str(e))
+            self.completed += 1
+            if self.completed == self._total:
+                self._done.set()
+
+    def _record(self, url: str, path: Path | None, error: str | None) -> None:
+        """Adds one result to the report. Call with self._lock held."""
+        if error is not None:
+            self._report.failed[url] = error
+        elif path is None:
+            self._report.skipped.append(url)
+        else:
+            self._report.saved.append(path)
+
+    def _fetch(self, url: str) -> Path | None:
+        response = self._open(url, timeout=self.timeout)
+        kind = response.headers.get_content_type()
+        if kind not in ALLOWED_TYPES:
+            log.warning("skipped %s: content type %s", url, kind)
+            return None
+        target = self.dest / safe_name(url)
+        with response, open(target, "wb") as out:
+            shutil.copyfileobj(response, out, CHUNK)
+        return target
diff --git a/tests/test_parallel.py b/tests/test_parallel.py
