index 0000000..29f1fe5
--- /dev/null
+++ b/tests/test_parallel.py
@@ -0,0 +1,54 @@
+import io
+from email.message import Message
+
+import pytest
+
+from fetcher.parallel import ParallelDownloader
+
+
+class FakeResponse(io.BytesIO):
+    def __init__(self, body: bytes, content_type: str):
+        super().__init__(body)
+        self.headers = Message()
+        self.headers["Content-Type"] = content_type
+
+
+def opener(pages: dict[str, tuple[bytes, str]]):
+    def open_url(url, timeout):
+        if url not in pages:
+            raise OSError(f"404 for {url}")
+        body, kind = pages[url]
+        return FakeResponse(body, kind)
+
+    return open_url
+
+
+def test_saves_each_allowed_file(tmp_path):
+    pages = {f"https://files.example.test/doc{i}.pdf": (b"%PDF" + bytes([i]), "application/pdf") for i in range(20)}
+    report = ParallelDownloader(tmp_path, workers=4, opener=opener(pages)).run(list(pages))
+    assert len(report.saved) == 20
+    assert sorted(p.read_bytes() for p in report.saved) == sorted(b for b, _ in pages.values())
+
+
+def test_skips_other_content_types(tmp_path):
+    pages = {
+        "https://files.example.test/a.pdf": (b"%PDF", "application/pdf"),
+        "https://files.example.test/b.html": (b"<html>", "text/html; charset=utf-8"),
+    }
+    report = ParallelDownloader(tmp_path, workers=2, opener=opener(pages)).run(list(pages))
+    assert report.skipped == ["https://files.example.test/b.html"]
+    assert len(report.saved) == 1
+
+
+def test_reports_failed_urls(tmp_path):
+    report = ParallelDownloader(tmp_path, workers=2, opener=opener({})).run(["https://files.example.test/x.zip"])
+    assert list(report.failed) == ["https://files.example.test/x.zip"]
+
+
+def test_returns_at_once_for_no_urls(tmp_path):
+    assert ParallelDownloader(tmp_path).run([]).saved == []
+
+
+def test_refuses_zero_workers(tmp_path):
+    with pytest.raises(ValueError):
+        ParallelDownloader(tmp_path, workers=0)
