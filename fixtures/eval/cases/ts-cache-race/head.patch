@@ -22,4 +50,24 @@ export class UserService {
     const user = await this.getUser(id);
     return user ? this.repo.findByTeam(user.teamId) : [];
   }
+
+  cacheStats(): CacheStats {
+    return this.cache.stats();
+  }
+
+  private startRefresh(id: string): void {
+    if (this.refreshing.has(id)) return;
+    this.refreshing.add(id);
+    void this.refresh(id)
+      .catch((e: unknown) => this.log.warn("user refresh failed", { id, error: String(e) }))
+      .finally(() => this.refreshing.delete(id));
+  }
+
+  // The write is skipped when a delete or another write replaced the entry during the read.
+  private async refresh(id: string): Promise<void> {
+    const stamp = this.cache.stamp(id);
+    const user = await this.repo.findById(id);
+    if (user) this.cache.setIfCurrent(id, user, stamp);
+    else this.cache.deleteIfCurrent(id, stamp);
+  }
 }
diff --git a/tests/users/cache.test.ts b/tests/users/cache.test.ts
new file mode 100644
index 0000000..7f81297
--- /dev/null
+++ b/tests/users/cache.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { TtlCache } from "../../src/users/cache";
+
+function clock(start = 1_000) {
+  let t = start;
+  return {
+    now: () => t,
+    advance: (ms: number) => {
+      t += ms;
+    },
+  };
+}
+
+describe("TtlCache", () => {
+  it("returns a stored value until the ttl ends", () => {
+    const c = clock();
+    const cache = new TtlCache<string, number>({ ttlMs: 100, maxEntries: 10, now: c.now });
+    cache.set("a", 1);
+    c.advance(99);
+    expect(cache.get("a")).toBe(1);
+    c.advance(1);
+    expect(cache.get("a")).toBeUndefined();
+  });
+
+  it("counts hits and misses", () => {
+    const cache = new TtlCache<string, number>({ ttlMs: 100, maxEntries: 10 });
+    cache.set("a", 1);
+    cache.get("a");
+    cache.get("b");
+    expect(cache.stats()).toMatchObject({ hits: 1, misses: 1, size: 1 });
+  });
+
+  it("reports the age of an entry", () => {
+    const c = clock();
+    const cache = new TtlCache<string, number>({ ttlMs: 100, maxEntries: 10, now: c.now });
+    cache.set("a", 1);
+    c.advance(40);
+    expect(cache.ageOf("a")).toBe(40);
+    expect(cache.ageOf("b")).toBeUndefined();
+  });
+
+  it("skips a conditional write after a delete", () => {
+    const cache = new TtlCache<string, number>({ ttlMs: 100, maxEntries: 10 });
+    cache.set("a", 1);
+    const stamp = cache.stamp("a");
+    cache.delete("a");
+    expect(cache.setIfCurrent("a", 2, stamp)).toBe(false);
+    expect(cache.get("a")).toBeUndefined();
+  });
+
+  it("applies a conditional write while the entry is unchanged", () => {
+    const cache = new TtlCache<string, number>({ ttlMs: 100, maxEntries: 10 });
+    cache.set("a", 1);
+    expect(cache.setIfCurrent("a", 2, cache.stamp("a"))).toBe(true);
+    expect(cache.get("a")).toBe(2);
+  });
+
+  it("rejects bad options", () => {
+    expect(() => new TtlCache({ ttlMs: 0, maxEntries: 1 })).toThrow(RangeError);
+    expect(() => new TtlCache({ ttlMs: 10, maxEntries: 0 })).toThrow(RangeError);
+  });
+});
diff --git a/tests/users/service.test.ts b/tests/users/service.test.ts
new file mode 100644
index 0000000..f74cbb2
--- /dev/null
+++ b/tests/users/service.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it, vi } from "vitest";
+import type { Logger } from "../../src/log";
+import type { UserRepo } from "../../src/users/repo";
+import { UserService } from "../../src/users/service";
+import type { User } from "../../src/users/types";
+
+const ada: User = { id: "u1", name: "Ada", email: "ada@example.test", teamId: "t1", updatedAt: 1 };
+const log: Logger = { info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+
+function repoWith(user: User | null) {
+  return {
+    findById: vi.fn(async () => user),
+    findByTeam: vi.fn(async () => []),
+    update: vi.fn(async () => user),
+  } as unknown as UserRepo & { findById: ReturnType<typeof vi.fn> };
+}
+
+describe("UserService cache", () => {
+  it("reads the database once for two lookups", async () => {
+    const repo = repoWith(ada);
+    const service = new UserService(repo, log);
+    await service.getUser("u1");
+    await service.getUser("u1");
+    expect(repo.findById).toHaveBeenCalledTimes(1);
+    expect(service.cacheStats().hits).toBe(1);
+  });
+
+  it("reads the database again after an update", async () => {
+    const repo = repoWith(ada);
+    const service = new UserService(repo, log);
+    await service.getUser("u1");
+    await service.updateUser("u1", { name: "Ada L." });
+    await service.getUser("u1");
+    expect(repo.findById).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not cache a missing user", async () => {
+    const repo = repoWith(null);
+    const service = new UserService(repo, log);
+    expect(await service.getUser("u2")).toBeNull();
+    expect(await service.getUser("u2")).toBeNull();
+    expect(repo.findById).toHaveBeenCalledTimes(2);
+  });
+});
