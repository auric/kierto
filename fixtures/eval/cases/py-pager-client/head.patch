@@ -0,0 +1,18 @@
+from client.api import DirectoryClient
+from jobs import count_users
+from tests.test_api import Server
+
+
+class Dashboard:
+    def __init__(self):
+        self.values: dict[str, int] = {}
+
+    def report(self, name: str, value: int) -> None:
+        self.values[name] = value
+
+
+def test_reports_every_user():
+    dashboard = Dashboard()
+    client = DirectoryClient("https://directory.example.test", "token", backoff=0, opener=Server(total=230))
+    assert count_users.run(client, dashboard) == 230
+    assert dashboard.values == {"directory_users": 230}
