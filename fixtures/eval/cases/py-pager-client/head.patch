@@ -0,0 +1,59 @@
+import io
+import json
+from urllib.error import HTTPError
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+
+from client.api import DirectoryClient
+
+
+class Server:
+    """A fake directory with total users, and scripted failures by request number."""
+
+    def __init__(self, total: int, failures: dict[int, int] | None = None):
+        self.total = total
+        self.failures = failures or {}
+        self.requests: list[dict] = []
+
+    def __call__(self, request, timeout):
+        n = len(self.requests)
+        query = {k: int(v[0]) for k, v in parse_qs(urlparse(request.full_url).query).items()}
+        self.requests.append(query)
+        if n in self.failures:
+            raise HTTPError(request.full_url, self.failures[n], "failure", {}, None)
+        start = query["page"] * query["per_page"]
+        users = [{"id": f"u{i}", "email": f"u{i}@example.test", "name": f"User {i}", "secret": "x"} for i in range(start, min(start + query["per_page"], self.total))]
+        return io.BytesIO(json.dumps({"users": users, "total": self.total}).encode())
+
+
+def client(server: Server) -> DirectoryClient:
+    return DirectoryClient("https://directory.example.test", "token", backoff=0, opener=server)
+
+
+def test_fetch_page_counts_from_zero():
+    server = Server(total=250)
+    page = client(server).fetch_page(0)
+    assert [u["id"] for u in page["items"]][:2] == ["u0", "u1"]
+    assert page["total_pages"] == 3
+
+
+def test_fetch_page_keeps_only_known_fields():
+    page = client(Server(total=1)).fetch_page(0)
+    assert page["items"] == [{"id": "u0", "email": "u0@example.test", "name": "User 0"}]
+
+
+def test_iter_users_yields_each_user_once():
+    ids = [u["id"] for u in client(Server(total=250)).iter_users(per_page=100)]
+    assert ids == [f"u{i}" for i in range(250)]
+
+
+def test_retries_a_busy_server():
+    server = Server(total=5, failures={0: 503})
+    assert len(client(server).fetch_page(0)["items"]) == 5
+    assert len(server.requests) == 2
+
+
+def test_does_not_retry_a_client_error():
+    with pytest.raises(HTTPError):
+        client(Server(total=5, failures={0: 404})).fetch_page(0)
