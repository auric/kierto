diff --git a/src/parser_v2.cpp b/src/parser_v2.cpp
new file mode 100644
index 0000000..1040566
--- /dev/null
+++ b/src/parser_v2.cpp
@@ -0,0 +1,46 @@
+#include "crc16.h"
+#include "parsers.h"
+#include "reader.h"
+
+namespace telemetry {
+
+namespace {
+
+// Magic, version, device ID, sample count, label length, and checksum.
+constexpr std::size_t kMinV2Size = 2 + 1 + 4 + 2 + 1 + 2;
+
+}  // namespace
+
+// docs/protocol-v2.md gives the layout.
+ParseError parseV2(const std::uint8_t* data, std::size_t size, Packet& out) {
+  if (size < kMinV2Size) return ParseError::kTooShort;
+  const std::uint16_t expected = crc16(data + 2, size - 4);
+
+  ByteReader r(data + 2, size - 2);
+  std::uint8_t version = 0;
+  std::uint16_t count = 0;
+  if (!r.u8(version) || !r.u32(out.header.deviceId) || !r.u16(count)) return ParseError::kTruncated;
+  if (count > kMaxSamples) return ParseError::kTooManySamples;
+  out.header.version = version;
+
+  out.samples.clear();
+  out.samples.reserve(count);
+  for (std::uint16_t i = 0; i < count; ++i) {
+    Sample s{};
+    if (!r.u16(s.sensor) || !r.i32(s.value)) return ParseError::kTruncated;
+    out.samples.push_back(s);
+  }
+
+  std::uint8_t labelLen = 0;
+  if (!r.u8(labelLen)) return ParseError::kTruncated;
+  if (labelLen > kLabelSize) return ParseError::kLabelTooLong;
+  if (!r.bytes(labelLen, out.header.label)) return ParseError::kTruncated;
+  out.header.label[labelLen] = '\0';
+
+  std::uint16_t crc;
+  r.u16(crc);
+  if (crc != expected) return ParseError::kBadChecksum;
+  return ParseError::kNone;
+}
+
+}  // namespace telemetry
