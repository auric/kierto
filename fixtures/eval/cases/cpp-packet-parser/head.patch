+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "telemetry/packet.h"
+
+namespace telemetry {
+
+// The parser of each version. data starts at the magic. parsePacket checks the magic and the version byte first.
+ParseError parseV1(const std::uint8_t* data, std::size_t size, Packet& out);
+ParseError parseV2(const std::uint8_t* data, std::size_t size, Packet& out);
+
+}  // namespace telemetry
diff --git a/tests/parser_v2_test.cpp b/tests/parser_v2_test.cpp
new file mode 100644
index 0000000..2b7a0a8
--- /dev/null
+++ b/tests/parser_v2_test.cpp
@@ -0,0 +1,93 @@
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "crc16.h"
+#include "telemetry/packet.h"
+
+namespace {
+
+using Bytes = std::vector<std::uint8_t>;
+
+void put16(Bytes& b, std::uint16_t v) {
+  b.push_back(static_cast<std::uint8_t>(v & 0xFF));
+  b.push_back(static_cast<std::uint8_t>(v >> 8));
+}
+
+void put32(Bytes& b, std::uint32_t v) {
+  for (int i = 0; i < 4; ++i) b.push_back(static_cast<std::uint8_t>(v >> (8 * i)));
+}
+
+Bytes packet(std::uint16_t samples, const std::string& label) {
+  Bytes b = {'T', 'L', 2};
+  put32(b, 0xA1B2C3D4);
+  put16(b, samples);
+  for (std::uint16_t i = 0; i < samples; ++i) {
+    put16(b, i);
+    put32(b, static_cast<std::uint32_t>(-100 + i));
+  }
+  b.push_back(static_cast<std::uint8_t>(label.size()));
+  b.insert(b.end(), label.begin(), label.end());
+  put16(b, telemetry::crc16(b.data() + 2, b.size() - 2));
+  return b;
+}
+
+void checkValue() {
+  const char* text = "123456789";
+  assert(telemetry::crc16(reinterpret_cast<const std::uint8_t*>(text), 9) == 0x29B1);
+}
+
+void parsesAPacket() {
+  Bytes b = packet(3, "boiler-2");
+  telemetry::Packet p{};
+  assert(telemetry::parsePacket(b.data(), b.size(), p) == telemetry::ParseError::kNone);
+  assert(p.header.version == 2);
+  assert(p.header.deviceId == 0xA1B2C3D4);
+  assert(p.samples.size() == 3);
+  assert(p.samples[2].sensor == 2 && p.samples[2].value == -98);
+  assert(std::strcmp(p.header.label, "boiler-2") == 0);
+}
+
+void acceptsTheLongestLabel() {
+  Bytes b = packet(0, std::string(31, 'x'));
+  telemetry::Packet p{};
+  assert(telemetry::parsePacket(b.data(), b.size(), p) == telemetry::ParseError::kNone);
+  assert(std::strlen(p.header.label) == 31);
+}
+
+void rejectsABadChecksum() {
+  Bytes b = packet(1, "a");
+  b.back() ^= 0xFF;
+  telemetry::Packet p{};
+  assert(telemetry::parsePacket(b.data(), b.size(), p) == telemetry::ParseError::kBadChecksum);
+}
+
+void rejectsTooManySamples() {
+  Bytes b = packet(0, "");
+  b[7] = 0xFF;
+  b[8] = 0xFF;
+  telemetry::Packet p{};
+  assert(telemetry::parsePacket(b.data(), b.size(), p) == telemetry::ParseError::kTooManySamples);
+}
+
+void rejectsAShortPacket() {
+  Bytes b = {'T', 'L', 2, 0, 0};
+  telemetry::Packet p{};
+  assert(telemetry::parsePacket(b.data(), b.size(), p) == telemetry::ParseError::kTooShort);
+}
+
+}  // namespace
+
+int main() {
+  checkValue();
+  parsesAPacket();
+  acceptsTheLongestLabel();
+  rejectsABadChecksum();
+  rejectsTooManySamples();
+  rejectsAShortPacket();
+  std::cout << "parser_v2_test: ok\n";
+  return 0;
+}
