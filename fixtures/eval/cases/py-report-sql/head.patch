+# Sales reports
+
+Reports for the regional managers.
+
+## Endpoints
+
+- `GET /reports/monthly?year=2026&month=2`: totals per region for one month.
+- `GET /reports/regional?region=north&since=2026-01-01&limit=50`: the best-selling products of one region, in whole euros.
+- `GET /reports/regional.pdf?...`: the same report as a PDF. The server needs `wkhtmltopdf` on PATH.
diff --git a/app/reports/regional.py b/app/reports/regional.py
new file mode 100644
index 0000000..ce4d17a
--- /dev/null
+++ b/app/reports/regional.py
@@ -0,0 +1,61 @@
+"""Sales per product in one region, as JSON or as a PDF for the regional managers."""
+
+import html
+import subprocess
+import tempfile
+from datetime import date
+from pathlib import Path
+
+from app.db import query
+
+MAX_ROWS = 500
+PDF_TIMEOUT_S = 60
+
+
+def regional_sales(region: str, since: date, limit: int = 50) -> list[dict]:
+    """The best-selling products of one region since a day. Totals are in whole euros."""
+    rows = query(
+        f"""
+        SELECT p.name AS product, SUM(s.amount_cents) AS total_cents, COUNT(*) AS orders
+        FROM sales s JOIN products p ON p.id = s.product_id
+        WHERE s.region = '{region}' AND s.sold_on >= ?
+        GROUP BY p.name
+        ORDER BY total_cents DESC
+        LIMIT {min(int(limit), MAX_ROWS)}
+        """,
+        (since.isoformat(),),
+    )
+    return [
+        {"product": r["product"], "total_eur": round(r["total_cents"] / 100), "orders": r["orders"]}
+        for r in rows
+    ]
+
+
+def to_html(region: str, since: date, rows: list[dict]) -> str:
+    cells = "\n".join(
+        f"<tr><td>{html.escape(r['product'])}</td><td>{r['total_eur']}</td><td>{r['orders']}</td></tr>"
+        for r in rows
+    )
+    title = f"Sales in {html.escape(region)} since {since.isoformat()}"
+    return f"""<!doctype html>
+<html>
+<head><meta charset="utf-8"><title>{title}</title></head>
+<body>
+<h1>{title}</h1>
+<table>
+<tr><th>Product</th><th>Total (EUR)</th><th>Orders</th></tr>
+{cells}
+</table>
+</body>
+</html>
+"""
+
+
+def render_pdf(page: str) -> bytes:
+    """Renders an HTML page with wkhtmltopdf."""
+    with tempfile.TemporaryDirectory() as tmp:
+        source = Path(tmp) / "report.html"
+        target = Path(tmp) / "report.pdf"
+        source.write_text(page, encoding="utf-8")
+        subprocess.run(["wkhtmltopdf", "--quiet", str(source), str(target)], timeout=PDF_TIMEOUT_S)
+        return target.read_bytes() if target.exists() else b""
