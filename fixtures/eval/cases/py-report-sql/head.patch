+
+
+def _regional_args() -> tuple[str, date, int]:
+    region = request.args.get("region", "").strip()
+    if not region:
+        abort(400, "region is required")
+    try:
+        since = date.fromisoformat(request.args.get("since", f"{date.today().year}-01-01"))
+        limit = int(request.args.get("limit", "50"))
+    except ValueError:
+        abort(400, "since must be YYYY-MM-DD and limit must be an integer")
+    if limit < 1:
+        abort(400, "limit must be positive")
+    return region, since, limit
+
+
+@app.get("/reports/regional")
+def regional():
+    region, since, limit = _regional_args()
+    return jsonify(regional_sales(region, since, limit))
+
+
+@app.get("/reports/regional.pdf")
+def regional_pdf():
+    region, since, limit = _regional_args()
+    pdf = render_pdf(to_html(region, since, regional_sales(region, since, limit)))
+    return Response(
+        pdf,
+        mimetype="application/pdf",
+        headers={"Content-Disposition": 'attachment; filename="regional-sales.pdf"'},
+    )
diff --git a/tests/test_regional.py b/tests/test_regional.py
