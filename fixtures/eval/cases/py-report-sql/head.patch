@@ -0,0 +1,57 @@
+import sqlite3
+import subprocess
+from datetime import date
+from pathlib import Path
+
+import pytest
+
+from app.reports import regional
+
+SCHEMA = Path(__file__).resolve().parent.parent / "schema.sql"
+
+
+@pytest.fixture
+def sales_db(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    conn = sqlite3.connect("sales.db")
+    conn.executescript(SCHEMA.read_text())
+    conn.executemany("INSERT INTO products (id, name) VALUES (?, ?)", [(1, "Kettle"), (2, "Toaster"), (3, "Mug")])
+    conn.executemany(
+        "INSERT INTO sales (product_id, region, amount_cents, sold_on) VALUES (?, ?, ?, ?)",
+        [
+            (1, "north", 4999, "2026-02-01"),
+            (1, "north", 4999, "2026-02-03"),
+            (2, "north", 2950, "2026-02-04"),
+            (3, "north", 899, "2025-12-30"),
+            (2, "south", 2950, "2026-02-04"),
+        ],
+    )
+    conn.commit()
+    conn.close()
+
+
+def test_sums_the_products_of_one_region(sales_db):
+    rows = regional.regional_sales("north", date(2026, 1, 1))
+    assert rows == [
+        {"product": "Kettle", "total_eur": 100, "orders": 2},
+        {"product": "Toaster", "total_eur": 30, "orders": 1},
+    ]
+
+
+def test_limits_the_rows(sales_db):
+    assert len(regional.regional_sales("north", date(2025, 1, 1), limit=1)) == 1
+
+
+def test_escapes_the_html(sales_db):
+    page = regional.to_html("<north>", date(2026, 1, 1), [{"product": "A&B", "total_eur": 1, "orders": 1}])
+    assert "&lt;north&gt;" in page
+    assert "A&amp;B" in page
+
+
+def test_render_pdf_returns_the_file(monkeypatch):
+    def fake_run(args, timeout):
+        Path(args[-1]).write_bytes(b"%PDF-1.7 fake")
+        return subprocess.CompletedProcess(args, 0)
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+    assert regional.render_pdf("<p>hi</p>").startswith(b"%PDF")
