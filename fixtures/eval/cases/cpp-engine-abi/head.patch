diff --git a/plugins/README.md b/plugins/README.md
index 38ec5fc..d32a452 100644
--- a/plugins/README.md
+++ b/plugins/README.md
@@ -3,3 +3,9 @@
 Plugins are shared objects that the host loads with `dlopen`. Third parties build them with their own compiler and release them on their own schedule, so a plugin often runs against a newer engine than the one it was built with.
 
 A plugin checks `engine_abi_version() == ENGINE_ABI_VERSION` when it loads and refuses to run on a mismatch.
+
+## Configuration
+
+A plugin reads its config file line by line and passes each `key=value` line to `engine_set_option()`. See `docs/options.md` for the keys.
+
+`sample_plugin.c` shows the pattern in `plugin_configure()`.
diff --git a/plugins/sample_plugin.c b/plugins/sample_plugin.c
index 8c4cd32..70dc18b 100644
--- a/plugins/sample_plugin.c
+++ b/plugins/sample_plugin.c
@@ -11,7 +11,19 @@ int plugin_load(void) {
     return -1;
   }
   engine_options opts = {.struct_size = sizeof opts, .worker_threads = 2, .queue_depth = 64, .log_level = 1};
-  return engine_create(&opts, &g_engine) == ENGINE_OK ? 0 : -1;
+  if (engine_create(&opts, &g_engine) != ENGINE_OK) return -1;
+  fprintf(stderr, "sample plugin: engine %s\n", engine_version(g_engine));
+  return 0;
+}
+
+/* Applies one key=value line of the plugin config file. */
+int plugin_configure(const char* line) {
+  char key[64];
+  const char* eq = strchr(line, '=');
+  if (!eq || (size_t)(eq - line) >= sizeof key) return -1;
+  memcpy(key, line, (size_t)(eq - line));
+  key[eq - line] = '\0';
+  return engine_set_option(g_engine, key, eq + 1) == ENGINE_OK ? 0 : -1;
 }
 
 int plugin_send(const char* text) {
diff --git a/src/engine.cpp b/src/engine.cpp
index ba3d90d..65b1ae8 100644
--- a/src/engine.cpp
+++ b/src/engine.cpp
@@ -5,16 +5,22 @@
 #include <deque>
 #include <mutex>
 #include <new>
+#include <stdexcept>
+#include <string>
 #include <vector>
 
+#include "version.h"
+
 namespace {
 
 constexpr size_t kMaxMessage = 1 << 20;
+constexpr uint32_t kMaxWorkers = 64;
 
 engine_options defaults() {
   engine_options o{};
   o.struct_size = sizeof o;
   o.worker_threads = 1;
+  o.flush_interval_ms = 0;
   o.queue_depth = 256;
   o.log_level = 1;
   return o;
@@ -24,6 +30,7 @@ engine_options defaults() {
 
 struct engine {
   engine_options options;
+  std::string version = ENGINE_VERSION_STRING;
   std::mutex mutex;
   std::deque<std::vector<unsigned char>> queue;
 };
@@ -38,7 +45,7 @@ engine_status engine_create(const engine_options* options, engine** out) {
   engine_options opts = defaults();
   std::memcpy(&opts, options, std::min<size_t>(options->struct_size, sizeof opts));
   opts.struct_size = sizeof opts;
-  if (opts.worker_threads == 0 || opts.queue_depth == 0) return ENGINE_EINVAL;
+  if (opts.worker_threads == 0 || opts.worker_threads > kMaxWorkers || opts.queue_depth == 0) return ENGINE_EINVAL;
   try {
     engine* e = new engine();
     e->options = opts;
@@ -68,6 +75,26 @@ engine_status engine_submit(engine* e, const void* data, size_t size) {
   }
 }
 
+engine_status engine_set_option(engine* e, const char* key, const char* value) {
+  if (!e || !key || !value) return ENGINE_EINVAL;
+  const std::string k = key;
+  std::lock_guard<std::mutex> lock(e->mutex);
+  if (k == "log_level") {
+    e->options.log_level = std::stoi(value);
+  } else if (k == "queue_depth") {
+    const unsigned long depth = std::stoul(value);
+    if (depth == 0) return ENGINE_EINVAL;
+    e->options.queue_depth = static_cast<uint32_t>(depth);
+  } else if (k == "flush_interval_ms") {
+    e->options.flush_interval_ms = static_cast<uint32_t>(std::stoul(value));
+  } else {
+    throw std::invalid_argument("unknown engine option: " + k);
+  }
+  return ENGINE_OK;
+}
+
+const char* engine_version(const engine* e) { return e ? e->version.c_str() : nullptr; }
+
 void engine_destroy(engine* e) { delete e; }
 
 }  // extern "C"
