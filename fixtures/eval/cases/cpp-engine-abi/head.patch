diff --git a/tests/engine_test.cpp b/tests/engine_test.cpp
new file mode 100644
index 0000000..e802931
--- /dev/null
+++ b/tests/engine_test.cpp
@@ -0,0 +1,65 @@
+#include <cassert>
+#include <cstring>
+#include <iostream>
+
+#include "engine/engine.h"
+
+namespace {
+
+engine* make(uint32_t workers = 2) {
+  engine_options o{};
+  o.struct_size = sizeof o;
+  o.worker_threads = workers;
+  o.queue_depth = 4;
+  engine* e = nullptr;
+  return engine_create(&o, &e) == ENGINE_OK ? e : nullptr;
+}
+
+void createsAndDestroys() {
+  engine* e = make();
+  assert(e != nullptr);
+  assert(std::strcmp(engine_version(e), "3.5.0") == 0);
+  engine_destroy(e);
+}
+
+void refusesTooManyWorkers() { assert(make(65) == nullptr); }
+
+void boundsTheQueue() {
+  engine* e = make();
+  for (int i = 0; i < 4; ++i) assert(engine_submit(e, "x", 1) == ENGINE_OK);
+  assert(engine_submit(e, "x", 1) == ENGINE_ESTATE);
+  engine_destroy(e);
+}
+
+void setsOptions() {
+  engine* e = make();
+  assert(engine_set_option(e, "queue_depth", "8") == ENGINE_OK);
+  assert(engine_set_option(e, "flush_interval_ms", "250") == ENGINE_OK);
+  assert(engine_set_option(e, "queue_depth", "0") == ENGINE_EINVAL);
+  for (int i = 0; i < 8; ++i) assert(engine_submit(e, "x", 1) == ENGINE_OK);
+  assert(engine_submit(e, "x", 1) == ENGINE_ESTATE);
+  engine_destroy(e);
+}
+
+void acceptsAnOlderStruct() {
+  // A caller built against the first release passes only struct_size and worker_threads.
+  struct {
+    uint32_t struct_size;
+    uint32_t worker_threads;
+  } old = {sizeof old, 2};
+  engine* e = nullptr;
+  assert(engine_create(reinterpret_cast<const engine_options*>(&old), &e) == ENGINE_OK);
+  engine_destroy(e);
+}
+
+}  // namespace
+
+int main() {
+  createsAndDestroys();
+  refusesTooManyWorkers();
+  boundsTheQueue();
+  setsOptions();
+  acceptsAnOlderStruct();
+  std::cout << "engine_test: ok\n";
+  return 0;
+}
