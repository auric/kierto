@@ -0,0 +1,12 @@
+# Engine options
+
+| Field | Range | Default | Run time key |
+|---|---|---|---|
+| `worker_threads` | 1 to 64 | 1 | none |
+| `flush_interval_ms` | 0 or more | 0 (flush after each message) | `flush_interval_ms` |
+| `queue_depth` | 1 or more | 256 | `queue_depth` |
+| `log_level` | 0 to 3 | 1 | `log_level` |
+
+`engine_create()` refuses more than 64 worker threads, because the worker pool cannot use more.
+
+`engine_set_option()` changes a value of a running engine. The plugins pass the lines of their config file as they are.
diff --git a/include/engine/engine.h b/include/engine/engine.h
index c59d28c..dc669f5 100644
--- a/include/engine/engine.h
+++ b/include/engine/engine.h
@@ -27,7 +27,8 @@ typedef enum engine_status {
 
 typedef struct engine_options {
   uint32_t struct_size; /* Set to sizeof(engine_options). The engine reads only the first struct_size bytes. */
-  uint32_t worker_threads;
+  uint32_t worker_threads; /* 1 to 64. */
+  uint32_t flush_interval_ms; /* 0: flush after each message. */
   uint32_t queue_depth;
   int32_t log_level; /* 0 errors, 1 warnings, 2 info, 3 debug. */
 } engine_options;
@@ -37,6 +38,13 @@ typedef struct engine engine;
 ENGINE_API uint32_t engine_abi_version(void);
 ENGINE_API engine_status engine_create(const engine_options* options, engine** out);
 ENGINE_API engine_status engine_submit(engine* e, const void* data, size_t size);
+
+/* Changes one option at run time. key: "log_level", "queue_depth", or "flush_interval_ms". value: a decimal number. */
+ENGINE_API engine_status engine_set_option(engine* e, const char* key, const char* value);
+
+/* The version string of the engine, such as "3.5.0". The string stays valid until engine_destroy(e). */
+ENGINE_API const char* engine_version(const engine* e);
+
 ENGINE_API void engine_destroy(engine* e);
 
