index ad71b86..96d27d9 100644
--- a/src/rotate.cpp
+++ b/src/rotate.cpp
@@ -1,26 +1,69 @@
 #include "rotate.h"
 
+#include <zlib.h>
+
 #include <cstdio>
+#include <ctime>
 #include <string>
+#include <vector>
 
 namespace logging {
 
 namespace {
 
-constexpr int kKeep = 10;
+constexpr int kKeepFiles = 5;
+constexpr std::size_t kChunk = 64 * 1024;
 
-std::string numbered(const std::string& path, int n) { return path + "." + std::to_string(n); }
+std::string archive(const std::string& path, int n) { return path + "." + std::to_string(n) + ".gz"; }
 
 }  // namespace
 
-void rotateIfNeeded(std::unique_ptr<LogFile>& log, long maxBytes) {
-  if (log->size() < maxBytes) return;
+bool compressFile(const std::string& src, const std::string& dst) {
+  std::FILE* in = std::fopen(src.c_str(), "rb");
+  if (!in) return false;
+  gzFile out = gzopen(dst.c_str(), "wb6");
+  if (!out) return false;
+
+  std::vector<char> buf(kChunk);
+  bool ok = true;
+  for (;;) {
+    const std::size_t n = std::fread(buf.data(), 1, buf.size(), in);
+    if (n > 0 && gzwrite(out, buf.data(), static_cast<unsigned>(n)) != static_cast<int>(n)) {
+      ok = false;
+      break;
+    }
+    if (n < buf.size()) {
+      ok = std::ferror(in) == 0;
+      break;
+    }
+  }
+  std::fclose(in);
+  if (gzclose(out) != Z_OK) ok = false;
+  if (!ok) std::remove(dst.c_str());
+  return ok;
+}
+
+bool rotateIfNeeded(std::unique_ptr<LogFile>& log, long maxBytes) {
+  if (log->size() < maxBytes) return false;
   const std::string path = log->path();
-  log.reset();
-  std::remove(numbered(path, kKeep).c_str());
-  for (int i = kKeep - 1; i >= 1; --i) std::rename(numbered(path, i).c_str(), numbered(path, i + 1).c_str());
-  std::rename(path.c_str(), numbered(path, 1).c_str());
-  log = openLog(path);
+  const std::string staged = path + ".rotating." + std::to_string(std::time(nullptr));
+  if (std::rename(path.c_str(), staged.c_str()) != 0) return false;
+
+  std::unique_ptr<LogFile> fresh = openLog(path);
+  if (!fresh) {
+    // The old file is still open. With its name back, no line goes to a file that nobody reads.
+    std::rename(staged.c_str(), path.c_str());
+    return false;
+  }
+  log = std::move(fresh);
+
+  std::remove(archive(path, kKeepFiles).c_str());
+  for (int i = kKeepFiles - 1; i >= 1; --i) {
+    // NOLINTNEXTLINE(cert-err33-c): an archive that does not exist yet is fine; the first rotations have fewer files.
+    std::rename(archive(path, i).c_str(), archive(path, i + 1).c_str());
+  }
+  if (compressFile(staged, archive(path, 1))) std::remove(staged.c_str());
+  return true;
 }
 
 }  // namespace logging
