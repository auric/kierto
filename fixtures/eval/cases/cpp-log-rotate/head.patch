diff --git a/tests/rotate_test.cpp b/tests/rotate_test.cpp
new file mode 100644
index 0000000..ef39487
--- /dev/null
+++ b/tests/rotate_test.cpp
@@ -0,0 +1,77 @@
+#include <zlib.h>
+
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+
+#include "log_file.h"
+#include "rotate.h"
+
+namespace fs = std::filesystem;
+
+namespace {
+
+fs::path tempDir(const std::string& name) {
+  fs::path dir = fs::temp_directory_path() / ("rotate-test-" + name);
+  fs::remove_all(dir);
+  fs::create_directories(dir);
+  return dir;
+}
+
+std::string gunzip(const fs::path& file) {
+  gzFile in = gzopen(file.string().c_str(), "rb");
+  assert(in != nullptr);
+  std::string out;
+  char buf[4096];
+  for (int n; (n = gzread(in, buf, sizeof buf)) > 0;) out.append(buf, static_cast<std::size_t>(n));
+  gzclose(in);
+  return out;
+}
+
+void keepsASmallLog() {
+  const fs::path dir = tempDir("small");
+  auto log = logging::openLog((dir / "app.log").string());
+  log->write("one line");
+  assert(!logging::rotateIfNeeded(log, 1 << 20));
+  assert(!fs::exists(dir / "app.log.1.gz"));
+}
+
+void compressesAFullLog() {
+  const fs::path dir = tempDir("full");
+  const std::string path = (dir / "app.log").string();
+  auto log = logging::openLog(path);
+  log->write("first");
+  assert(logging::rotateIfNeeded(log, 1));
+  log->write("second");
+  assert(gunzip(dir / "app.log.1.gz").find("first") != std::string::npos);
+  std::ifstream current(path);
+  std::string line;
+  std::getline(current, line);
+  assert(line.find("second") != std::string::npos);
+}
+
+void keepsFiveArchives() {
+  const fs::path dir = tempDir("five");
+  auto log = logging::openLog((dir / "app.log").string());
+  for (int i = 0; i < 8; ++i) {
+    log->write("entry " + std::to_string(i));
+    assert(logging::rotateIfNeeded(log, 1));
+  }
+  assert(fs::exists(dir / "app.log.5.gz"));
+  assert(!fs::exists(dir / "app.log.6.gz"));
+}
+
+void reportsAMissingFolder() { assert(logging::openLog("/nonexistent-dir/app.log") == nullptr); }
+
+}  // namespace
+
+int main() {
+  keepsASmallLog();
+  compressesAFullLog();
+  keepsFiveArchives();
+  reportsAMissingFolder();
+  std::cout << "rotate_test: ok\n";
+  return 0;
+}
