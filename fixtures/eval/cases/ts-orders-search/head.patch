+import { describe, expect, it } from "vitest";
+import { buildSearch, searchOrders } from "../../src/orders/search";
+
+describe("buildSearch", () => {
+  it("builds a query without filters", () => {
+    const s = buildSearch({});
+    expect(s.sql).toMatch(/FROM orders ORDER BY created_at DESC, id LIMIT \$1 OFFSET \$2$/);
+    expect(s.params).toEqual([50, 0]);
+    expect(s.countSql).toBe("SELECT count(*)::int AS total FROM orders");
+    expect(s.countParams).toEqual([]);
+  });
+
+  it("escapes LIKE wildcards in the search text", () => {
+    const s = buildSearch({ text: " 50%_off " });
+    expect(s.sql).toContain("customer_name ILIKE $1");
+    expect(s.params[0]).toBe("%50\\%\\_off%");
+  });
+
+  it("keeps only known statuses", () => {
+    expect(buildSearch({ statuses: ["paid", "lost"] }).sql).toContain("status IN ('paid')");
+    expect(buildSearch({ statuses: ["lost"] }).sql).not.toContain("status IN");
+  });
+
+  it("filters by date range and total", () => {
+    const s = buildSearch({ from: "2026-01-01", to: "2026-01-31", minTotalCents: 1000 });
+    expect(s.sql).toContain("created_at >= $1 AND created_at < ($2::date + 1) AND total_cents >= $3");
+    expect(s.countParams).toEqual(["2026-01-01", "2026-01-31", 1000]);
+  });
+
+  it("rejects a malformed date and a negative offset", () => {
+    expect(() => buildSearch({ from: "01/02/2026" })).toThrow(RangeError);
+    expect(() => buildSearch({ offset: -1 })).toThrow(RangeError);
+  });
+
+  it("sorts by a known column and falls back for an unknown one", () => {
+    expect(buildSearch({ sort: "total", order: "asc" }).sql).toContain("ORDER BY total_cents ASC, id");
+    expect(buildSearch({ sort: "password" }).sql).toContain("ORDER BY created_at DESC, id");
+  });
+
+  it("caps the limit", () => {
+    expect(buildSearch({ limit: 5000 }).params).toEqual([200, 0]);
+  });
+});
+
+describe("searchOrders", () => {
+  it("returns the rows and the total", async () => {
+    const calls: string[] = [];
+    const db = {
+      query: async <T>(sql: string): Promise<T[]> => {
+        calls.push(sql);
+        return (sql.startsWith("SELECT count") ? [{ total: 3 }] : [{ id: 1 }]) as T[];
+      },
+    };
+    expect(await searchOrders(db, { text: "smith" })).toEqual({ rows: [{ id: 1 }], total: 3 });
+    expect(calls).toHaveLength(2);
+  });
+});
