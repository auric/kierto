@@ -0,0 +1,82 @@
+import type { Db } from "../db";
+import { ORDER_COLUMNS } from "./repo";
+import { ORDER_STATUSES, type Order, type OrderStatus } from "./types";
+
+export type SearchQuery = {
+  text?: string;
+  statuses?: string[];
+  from?: string;
+  to?: string;
+  minTotalCents?: number;
+  sort?: string;
+  order?: string;
+  offset?: number;
+  limit?: number;
+};
+
+export type SearchResult = { rows: Order[]; total: number };
+
+export type BuiltSearch = { sql: string; params: unknown[]; countSql: string; countParams: unknown[] };
+
+const SORT_COLUMNS: Record<string, string> = {
+  created: "created_at",
+  total: "total_cents",
+  customer: "customer_name",
+};
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+const DEFAULT_LIMIT = 50;
+const MAX_LIMIT = 200;
+
+const isStatus = (s: string): s is OrderStatus => (ORDER_STATUSES as readonly string[]).includes(s);
+
+// Escapes the LIKE wildcards, so a search for "50%" matches that text and not every row.
+const likePattern = (text: string) => `%${text.replace(/[\\%_]/g, (c) => `\\${c}`)}%`;
+
+function checkInt(name: string, value: number | undefined, min: number) {
+  if (value !== undefined && (!Number.isInteger(value) || value < min)) throw new RangeError(`${name} must be an integer of at least ${min}`);
+}
+
+export function buildSearch(q: SearchQuery): BuiltSearch {
+  checkInt("offset", q.offset, 0);
+  checkInt("limit", q.limit, 1);
+  checkInt("minTotalCents", q.minTotalCents, 0);
+  const where: string[] = [];
+  const params: unknown[] = [];
+  const param = (v: unknown) => {
+    params.push(v);
+    return `$${params.length}`;
+  };
+
+  const text = q.text?.trim();
+  if (text) where.push(`customer_name ILIKE ${param(likePattern(text))}`);
+
+  if (q.statuses?.length) {
+    const statuses = q.statuses.filter(isStatus);
+    if (statuses.length) where.push(`status IN (${statuses.map((s) => `'${s}'`).join(", ")})`);
+  }
+
+  if (q.from !== undefined) {
+    if (!DATE.test(q.from)) throw new RangeError("from must be YYYY-MM-DD");
+    where.push(`created_at >= ${param(q.from)}`);
+  }
+  if (q.to !== undefined) {
+    if (!DATE.test(q.to)) throw new RangeError("to must be YYYY-MM-DD");
+    where.push(`created_at < (${param(q.to)}::date + 1)`);
+  }
+  if (q.minTotalCents !== undefined) where.push(`total_cents >= ${param(q.minTotalCents)}`);
+
+  const filter = where.length ? ` WHERE ${where.join(" AND ")}` : "";
+  const countSql = `SELECT count(*)::int AS total FROM orders${filter}`;
+  const countParams = [...params];
+  const column = SORT_COLUMNS[q.sort ?? "created"] ?? "created_at";
+  const direction = (q.order ?? "desc").toUpperCase();
+  const limit = Math.min(q.limit ?? DEFAULT_LIMIT, MAX_LIMIT);
+  const sql = `SELECT ${ORDER_COLUMNS} FROM orders${filter} ORDER BY ${column} ${direction}, id LIMIT ${param(limit)} OFFSET ${param(q.offset ?? 0)}`;
+  return { sql, params, countSql, countParams };
+}
+
+export async function searchOrders(db: Db, q: SearchQuery): Promise<SearchResult> {
+  const s = buildSearch(q);
+  const [rows, count] = await Promise.all([db.query<Order>(s.sql, s.params), db.query<{ total: number }>(s.countSql, s.countParams)]);
+  return { rows, total: count[0]?.total ?? 0 };
+}
