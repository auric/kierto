+import unittest
+from decimal import Decimal
+
+from catalog import events
+from catalog.admin import set_price
+from catalog.cache import PriceCache
+from catalog.importer import import_prices
+from catalog.model import Price
+
+
+class FakeRepo:
+    def __init__(self, prices):
+        self.prices = {p.sku: p for p in prices}
+        self.queries = 0
+
+    def get(self, sku):
+        self.queries += 1
+        return self.prices.get(sku)
+
+    def get_many(self, skus):
+        self.queries += 1
+        return {s: self.prices[s] for s in skus if s in self.prices}
+
+    def update(self, sku, amount):
+        self.prices[sku] = Price(sku, amount, self.prices[sku].currency)
+
+    def update_many(self, rows):
+        for sku, amount in rows:
+            self.update(sku, amount)
+        return len(rows)
+
+
+def eur(sku, amount):
+    return Price(sku, Decimal(amount), "EUR")
+
+
+class PriceCacheTest(unittest.TestCase):
+    def setUp(self):
+        self.bus = events.EventBus()
+        self.repo = FakeRepo([eur("A-1", "120"), eur("B-2", "9.90")])
+        self.cache = PriceCache(self.repo, self.bus)
+
+    def test_reads_each_price_once(self):
+        self.cache.price("A-1")
+        self.cache.price("A-1")
+        self.assertEqual(self.repo.queries, 1)
+        self.assertEqual((self.cache.hits, self.cache.misses), (1, 1))
+
+    def test_fetches_the_missing_prices_in_one_query(self):
+        self.cache.price("A-1")
+        self.assertEqual(self.cache.prices(["A-1", "B-2", "C-3"]), {"A-1": eur("A-1", "120"), "B-2": eur("B-2", "9.90")})
+        self.assertEqual(self.repo.queries, 2)
+
+    def test_does_not_cache_an_unknown_sku(self):
+        self.assertIsNone(self.cache.price("C-3"))
+        self.repo.prices["C-3"] = eur("C-3", "5")
+        self.assertEqual(self.cache.price("C-3"), eur("C-3", "5"))
+
+    def test_a_price_change_from_the_admin_page_drops_the_entry(self):
+        self.cache.price("A-1")
+        set_price(self.repo, self.bus, "A-1", Decimal("125"))
+        self.assertEqual(self.cache.price("A-1").amount, Decimal("125"))
+
+    def test_the_bulk_import_refreshes_cached_prices(self):
+        self.cache.prices(["A-1", "B-2"])
+        import_prices(self.repo, self.bus, [("A-1", Decimal("125")), ("B-2", Decimal("8.50"))])
+        self.assertTrue(self.cache.price("A-1").amount, Decimal("125"))
+        self.assertTrue(self.cache.price("B-2").amount, Decimal("8.50"))
