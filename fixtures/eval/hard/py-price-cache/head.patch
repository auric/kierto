+"""In-process cache of the catalog prices for GET /prices."""
+
+from catalog import events
+from catalog.model import Price
+from catalog.repo import PriceRepo
+
+
+class PriceCache:
+    """Keeps each price after its first lookup.
+
+    A price.changed event drops the entry of its SKU, so the cache needs no TTL: an entry lives until its price changes.
+    Unknown SKUs are not cached, so a new product shows up on its first lookup.
+    """
+
+    def __init__(self, repo: PriceRepo, bus: events.EventBus) -> None:
+        self._repo = repo
+        self._prices: dict[str, Price] = {}
+        self.hits = 0
+        self.misses = 0
+        bus.subscribe(events.PRICE_CHANGED, self._drop)
+
+    def price(self, sku: str) -> Price | None:
+        cached = self._prices.get(sku)
+        if cached is not None:
+            self.hits += 1
+            return cached
+        self.misses += 1
+        found = self._repo.get(sku)
+        if found is not None:
+            self._prices[sku] = found
+        return found
+
+    def prices(self, skus: list[str]) -> dict[str, Price]:
+        """The prices of the known SKUs, in request order. One repo query fetches the missing ones."""
+        missing = [s for s in skus if s not in self._prices]
+        self.hits += len(skus) - len(missing)
+        self.misses += len(missing)
+        if missing:
+            self._prices.update(self._repo.get_many(missing))
+        return {s: self._prices[s] for s in skus if s in self._prices}
+
+    def _drop(self, sku: str) -> None:
+        self._prices.pop(sku, None)
+
+    def __len__(self) -> int:
+        return len(self._prices)
