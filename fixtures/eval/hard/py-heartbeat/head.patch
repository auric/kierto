diff --git a/worker/heartbeat.py b/worker/heartbeat.py
new file mode 100644
index 0000000..926b2f3
--- /dev/null
+++ b/worker/heartbeat.py
@@ -0,0 +1,43 @@
+"""Keeps the lease of the running job alive while a step runs."""
+
+import logging
+import threading
+
+from worker import settings
+from worker.queue import Queue
+from worker.state import JobState
+
+log = logging.getLogger(__name__)
+
+
+class Heartbeat:
+    """Moves heartbeat_at of the running job every interval on its own thread, so a step that blocks for minutes keeps
+    its lease."""
+
+    def __init__(self, queue: Queue, state: JobState, worker_id: str, interval_s: float = settings.HEARTBEAT_INTERVAL_S) -> None:
+        self._queue = queue
+        self._state = state
+        self._worker_id = worker_id
+        self._interval_s = interval_s
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._run, name="heartbeat", daemon=True)
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+        self._thread.join()
+
+    def alive(self) -> bool:
+        return self._thread.is_alive()
+
+    def _run(self) -> None:
+        while not self._stop.wait(self._interval_s):
+            job_id = self._state.job_id
+            if job_id is None:
+                continue
+            try:
+                self._queue.beat(job_id, self._worker_id)
+            except Exception:
+                log.warning("heartbeat of job %s failed; the next one tries again", job_id, exc_info=True)
