@@ -0,0 +1,6 @@
+# Changelog
+
+## 1.9.0
+
+- A report month that renders for more than 60 s no longer loses its job: a heartbeat thread keeps the lease of the running job alive between steps and during a step.
+- The runner no longer moves the heartbeat after each step.
diff --git a/README.md b/README.md
index b49c9e2..794a7c4 100644
--- a/README.md
+++ b/README.md
@@ -3,7 +3,8 @@
 Runs the background jobs of the reporting service from the `jobs` table.
 
 - A worker claims one job at a time. The claim gives it a lease: `worker` and `heartbeat_at` on the job row.
-- A handler is a generator. Each `yield` ends one step, and the runner moves `heartbeat_at` after each step.
+- A handler is a generator. Each `yield` ends one step.
+- A heartbeat thread in each worker moves `heartbeat_at` of the running job every `HEARTBEAT_INTERVAL_S`, also while one step runs for minutes.
 - `worker/supervisor.py` runs each minute on the scheduler host. It puts a running job back into the queue when its `heartbeat_at` is older than `STALE_AFTER_S`.
 - A worker that lost its lease cannot complete the job: `complete()` raises `LostOwnership`.
 - `GET /status` on port 9102 shows the job that the worker runs.
diff --git a/tests/test_heartbeat.py b/tests/test_heartbeat.py
new file mode 100644
index 0000000..5653823
--- /dev/null
+++ b/tests/test_heartbeat.py
@@ -0,0 +1,85 @@
+import threading
+import time
+
+from worker.heartbeat import Heartbeat
+from worker.state import JobState
+
+
+class RecordingQueue:
+    def __init__(self, fail_first=0):
+        self.beats = []
+        self.fail_first = fail_first
+        self._lock = threading.Lock()
+
+    def beat(self, job_id, worker_id):
+        with self._lock:
+            if self.fail_first:
+                self.fail_first -= 1
+                raise ConnectionError("database down")
+            self.beats.append((job_id, worker_id))
+
+    def count(self):
+        with self._lock:
+            return len(self.beats)
+
+
+def wait_for(cond, timeout=2.0):
+    end = time.monotonic() + timeout
+    while time.monotonic() < end:
+        if cond():
+            return True
+        time.sleep(0.01)
+    return False
+
+
+def start(queue, state):
+    hb = Heartbeat(queue, state, "w1", interval_s=0.01)
+    hb.start()
+    return hb
+
+
+def test_beats_the_running_job():
+    q, state = RecordingQueue(), JobState()
+    state.job_id = 7
+    hb = start(q, state)
+    try:
+        assert wait_for(lambda: q.count() >= 3)
+    finally:
+        hb.stop()
+    assert set(q.beats) == {(7, "w1")}
+
+
+def test_does_not_beat_without_a_running_job():
+    q = RecordingQueue()
+    hb = start(q, JobState())
+    time.sleep(0.1)
+    hb.stop()
+    assert q.beats == []
+
+
+def test_follows_the_next_job():
+    q, state = RecordingQueue(), JobState()
+    state.job_id = 1
+    hb = start(q, state)
+    try:
+        assert wait_for(lambda: q.count() >= 1)
+        state.job_id = 2
+        assert wait_for(lambda: (2, "w1") in q.beats)
+    finally:
+        hb.stop()
+
+
+def test_keeps_beating_after_a_failed_beat():
+    q, state = RecordingQueue(fail_first=2), JobState()
+    state.job_id = 5
+    hb = start(q, state)
+    try:
+        assert wait_for(lambda: q.count() >= 1)
+    finally:
+        hb.stop()
+
+
+def test_stop_ends_the_thread():
+    hb = start(RecordingQueue(), JobState())
+    hb.stop()
+    assert not hb.alive()
