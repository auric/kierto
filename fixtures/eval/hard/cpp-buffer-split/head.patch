+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "net/send_ring.h"
+#include "test_util.h"
+
+using namespace net;
+
+namespace {
+
+void ringKeepsTheOrderAcrossTheWrap() {
+  BufferPool pool(16, 8);
+  SendRing ring(4);
+  for (int round = 0; round < 3; ++round) {
+    for (std::uint8_t i = 0; i < 3; ++i) {
+      auto b = pool.acquire();
+      const std::uint8_t v[] = {i};
+      assert(b->append(v));
+      assert(ring.push(b));
+    }
+    for (std::uint8_t i = 0; i < 3; ++i) {
+      assert(ring.front()->view(0, 1)[0] == i);
+      ring.pop();
+    }
+  }
+  assert(ring.empty() && pool.stats().inUse == 0);
+}
+
+void ringRefusesWhenFull() {
+  BufferPool pool(16, 8);
+  SendRing ring(2);
+  auto a = pool.acquire();
+  auto b = pool.acquire();
+  auto c = pool.acquire();
+  assert(ring.push(a) && ring.push(b));
+  assert(!ring.push(c));
+  assert(c != nullptr);
+}
+
+}  // namespace
+
+int main() {
+  ringKeepsTheOrderAcrossTheWrap();
+  ringRefusesWhenFull();
+  std::puts("send_ring_test: ok");
+  return 0;
+}
