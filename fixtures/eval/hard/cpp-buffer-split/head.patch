+#pragma once
+
+#include <cassert>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "net/buffer.h"
+
+// A buffer that holds exactly these bytes.
+inline net::Buffer bufferWith(const std::vector<std::uint8_t>& bytes) {
+  net::Buffer b(bytes.size());
+  assert(b.append(bytes));
+  return b;
+}
+
+inline std::vector<std::uint8_t> frameBytes(const std::string& payload) {
+  const auto n = static_cast<std::uint32_t>(payload.size());
+  std::vector<std::uint8_t> out{std::uint8_t(n >> 24), std::uint8_t(n >> 16), std::uint8_t(n >> 8), std::uint8_t(n)};
+  out.insert(out.end(), payload.begin(), payload.end());
+  return out;
+}
+
+inline std::string text(std::span<const std::uint8_t> s) { return std::string(s.begin(), s.end()); }
