+#pragma once
+
+#include <cstddef>
+#include <vector>
+
+#include "net/buffer_pool.h"
+
+namespace net {
+
+// The buffers that wait to be sent on one connection, oldest first. capacity must be a power of two.
+class SendRing {
+ public:
+  explicit SendRing(std::size_t capacity);
+
+  // Returns false, and keeps the buffer with the caller, when the ring is full.
+  bool push(BufferPool::Pooled& b);
+  // The oldest buffer, or nullptr when the ring is empty.
+  Buffer* front();
+  // Removes the oldest buffer and gives it back to its pool.
+  void pop();
+
+  std::size_t size() const { return count_; }
+  bool empty() const { return count_ == 0; }
+
+ private:
+  std::vector<BufferPool::Pooled> slots_;
+  std::size_t mask_;
+  std::size_t head_ = 0;
+  std::size_t count_ = 0;
+};
+
+}  // namespace net
diff --git a/src/net/buffer.cpp b/src/net/buffer.cpp
new file mode 100644
index 0000000..6519f65
--- /dev/null
+++ b/src/net/buffer.cpp
@@ -0,0 +1,30 @@
+#include "net/buffer.h"
+
+#include <cstring>
+
+namespace net {
+
+Buffer::Buffer(std::size_t capacity) : data_(new std::uint8_t[capacity]), capacity_(capacity) {}
+
+bool Buffer::append(std::span<const std::uint8_t> bytes) {
+  if (bytes.size() > capacity_ - size_) return false;
+  std::memcpy(data_.get() + size_, bytes.data(), bytes.size());
+  size_ += bytes.size();
+  return true;
+}
+
+std::span<const std::uint8_t> Buffer::view(std::size_t offset, std::size_t len) const {
+  if (offset > size_ || len > capacity_ - offset) return {};
+  return {data_.get() + offset, len};
+}
+
+void Buffer::consume(std::size_t n) {
+  if (n >= size_) {
+    size_ = 0;
+    return;
+  }
+  std::memmove(data_.get(), data_.get() + n, size_ - n);
+  size_ -= n;
+}
+
+}  // namespace net
diff --git a/src/net/buffer_pool.cpp b/src/net/buffer_pool.cpp
new file mode 100644
index 0000000..3d5942b
--- /dev/null
+++ b/src/net/buffer_pool.cpp
@@ -0,0 +1,42 @@
+#include "net/buffer_pool.h"
+
+#include <stdexcept>
+
+namespace net {
+
+BufferPool::BufferPool(std::size_t bufferCapacity, std::size_t maxBuffers) : bufferCapacity_(bufferCapacity), maxBuffers_(maxBuffers) {
+  if (bufferCapacity == 0 || maxBuffers == 0) throw std::invalid_argument("BufferPool needs a capacity and a buffer count");
+  idle_.reserve(maxBuffers);
+}
+
+BufferPool::~BufferPool() {
+  for (Buffer* b : idle_) delete b;
+}
+
+BufferPool::Pooled BufferPool::acquire() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (inUse_ == maxBuffers_) {
+    ++refused_;
+    return Pooled(nullptr, Returner{this});
+  }
+  ++inUse_;
+  if (idle_.empty()) return Pooled(new Buffer(bufferCapacity_), Returner{this});
+  Buffer* b = idle_.back();
+  idle_.pop_back();
+  b->reset();
+  return Pooled(b, Returner{this});
+}
+
+void BufferPool::release(Buffer* b) {
+  if (!b) return;
+  std::lock_guard<std::mutex> lock(mutex_);
+  --inUse_;
+  idle_.push_back(b);
+}
+
+BufferPool::Stats BufferPool::stats() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return Stats{inUse_, idle_.size(), refused_};
+}
+
+}  // namespace net
