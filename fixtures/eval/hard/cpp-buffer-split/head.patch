diff --git a/tests/buffer_pool_test.cpp b/tests/buffer_pool_test.cpp
new file mode 100644
index 0000000..58e5722
--- /dev/null
+++ b/tests/buffer_pool_test.cpp
@@ -0,0 +1,45 @@
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "net/buffer_pool.h"
+#include "test_util.h"
+
+using namespace net;
+
+namespace {
+
+void poolReusesAReleasedBuffer() {
+  BufferPool pool(16, 2);
+  Buffer* first = nullptr;
+  {
+    auto b = pool.acquire();
+    first = b.get();
+    const std::uint8_t data[] = {9, 9};
+    assert(b->append(data));
+  }
+  auto again = pool.acquire();
+  assert(again.get() == first);
+  assert(again->size() == 0);
+}
+
+void poolRefusesBeyondItsLimit() {
+  BufferPool pool(16, 2);
+  auto a = pool.acquire();
+  auto b = pool.acquire();
+  auto c = pool.acquire();
+  assert(a && b && !c);
+  assert(pool.stats().refused == 1 && pool.stats().inUse == 2);
+}
+
+}  // namespace
+
+int main() {
+  poolReusesAReleasedBuffer();
+  poolRefusesBeyondItsLimit();
+  std::puts("buffer_pool_test: ok");
+  return 0;
+}
diff --git a/tests/buffer_test.cpp b/tests/buffer_test.cpp
new file mode 100644
index 0000000..32a020a
--- /dev/null
+++ b/tests/buffer_test.cpp
@@ -0,0 +1,67 @@
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <span>
+#include <string>
+#include <vector>
+
+#include "net/buffer.h"
+#include "test_util.h"
+
+using namespace net;
+
+namespace {
+
+void appendAndView() {
+  Buffer b(8);
+  const std::uint8_t data[] = {1, 2, 3, 4};
+  assert(b.append(data));
+  assert(b.size() == 4);
+  assert(b.view(1, 2).size() == 2 && b.view(1, 2)[0] == 2);
+  assert(b.view(0, 4).size() == 4);
+}
+
+void viewRefusesARangeOutsideTheWrittenPart() {
+  const Buffer b = bufferWith({1, 2, 3});
+  assert(b.view(0, 4).empty());
+  assert(b.view(4, 0).empty());
+  assert(b.view(2, 2).empty());
+  assert(b.view(1, ~std::size_t{0}).empty());
+}
+
+void appendRefusesBytesThatDoNotFit() {
+  Buffer b(3);
+  const std::uint8_t data[] = {1, 2, 3, 4};
+  assert(!b.append(data));
+  assert(b.size() == 0);
+}
+
+void consumeMovesTheRestToTheFront() {
+  Buffer b = bufferWith({1, 2, 3, 4, 5});
+  b.consume(2);
+  assert(b.size() == 3 && b.view(0, 1)[0] == 3);
+  b.consume(10);
+  assert(b.size() == 0);
+}
+
+void commitAddsReceivedBytes() {
+  Buffer b(8);
+  auto w = b.writable();
+  w[0] = 7;
+  w[1] = 8;
+  b.commit(2);
+  assert(b.size() == 2 && b.view(1, 1)[0] == 8);
+  assert(b.writable().size() == 6);
+}
+
+}  // namespace
+
+int main() {
+  appendAndView();
+  viewRefusesARangeOutsideTheWrittenPart();
+  appendRefusesBytesThatDoNotFit();
+  consumeMovesTheRestToTheFront();
+  commitAddsReceivedBytes();
+  std::puts("buffer_test: ok");
+  return 0;
+}
