diff --git a/src/json_line.cpp b/src/json_line.cpp
new file mode 100644
index 0000000..c4d03d8
--- /dev/null
+++ b/src/json_line.cpp
@@ -0,0 +1,32 @@
+#include "shipper/json_line.h"
+
+#include <chrono>
+
+namespace shipper {
+namespace {
+
+const char* levelName(Level level) {
+  switch (level) {
+    case Level::kDebug: return "debug";
+    case Level::kInfo: return "info";
+    case Level::kWarning: return "warning";
+    case Level::kError: return "error";
+  }
+  return "info";
+}
+
+}  // namespace
+
+std::string toJsonLine(const Record& r) {
+  const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(r.time().time_since_epoch()).count();
+  std::string out = "{\"ts\":" + std::to_string(ms) + ",\"level\":\"" + levelName(r.level()) + "\",\"msg\":\"";
+  out.reserve(out.size() + r.text().size() + 3);
+  for (const char c : r.text()) {
+    if (c == '"' || c == '\\') out += '\\';
+    out += c;
+  }
+  out += "\"}\n";
+  return out;
+}
+
+}  // namespace shipper
