new file mode 100644
index 0000000..cf4efda
--- /dev/null
+++ b/tests/payments/capture.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, test } from "bun:test";
+import type { AuditEvent, AuditLog } from "../../src/audit";
+import type { Config } from "../../src/config";
+import type { Order, OrderRepo } from "../../src/orders/repo";
+import { captureOrder } from "../../src/payments/capture";
+import {
+  CardDeclined,
+  type ChargeRequest,
+  type ChargeResult,
+  type Gateway,
+  GatewayTimeout,
+  GatewayUnavailable,
+} from "../../src/payments/gateway";
+
+const config = { payments: { retry: { maxAttempts: 3, baseDelayMs: 1 } } } as Config;
+const noWait = async () => {};
+
+const pending = (): Order => ({ id: "o-1", customerId: "c-1", status: "pending", totalCents: 4_990, currency: "EUR", cardToken: "tok_1" });
+
+function fakeOrders(order: Order) {
+  const calls: string[] = [];
+  const repo = {
+    get: async () => ({ ...order }),
+    markCapturing: async () => {
+      calls.push("capturing");
+      order.status = "capturing";
+    },
+    release: async () => {
+      calls.push("release");
+      order.status = "pending";
+    },
+    markPaid: async (_id: string, chargeId: string) => {
+      calls.push(`paid ${chargeId}`);
+      order.status = "paid";
+    },
+    markDeclined: async (_id: string, code: string) => {
+      calls.push(`declined ${code}`);
+      order.status = "declined";
+    },
+  };
+  return { orders: repo as unknown as OrderRepo, calls };
+}
+
+type Step = "ok" | "decline" | "timeout" | "unavailable";
+
+// Answers each charge with the next step of the script.
+function fakeGateway(script: Step[]) {
+  const requests: ChargeRequest[] = [];
+  const gateway = {
+    async charge(req: ChargeRequest): Promise<ChargeResult> {
+      requests.push(req);
+      const step = script.shift() ?? "ok";
+      if (step === "timeout") throw new GatewayTimeout("no answer");
+      if (step === "unavailable") throw new GatewayUnavailable("HTTP 503");
+      if (step === "decline") throw new CardDeclined("insufficient_funds");
+      return { status: "succeeded", chargeId: `ch_${requests.length}`, declineCode: null };
+    },
+  };
+  return { gateway: gateway as unknown as Gateway, requests };
+}
+
+function fakeAudit() {
+  const events: AuditEvent[] = [];
+  return { audit: { record: async (e: AuditEvent) => void events.push(e) } as unknown as AuditLog, events };
+}
+
+describe("captureOrder", () => {
+  test("charges the order total and marks the order paid", async () => {
+    const { orders, calls } = fakeOrders(pending());
+    const { gateway, requests } = fakeGateway(["ok"]);
+    const { audit, events } = fakeAudit();
+    const result = await captureOrder({ orders, gateway, audit, config, wait: noWait }, "o-1");
+    expect(result).toEqual({ status: "paid", chargeId: "ch_1" });
+    expect(calls).toEqual(["capturing", "paid ch_1"]);
+    expect(requests[0]).toMatchObject({ amountCents: 4_990, currency: "EUR", cardToken: "tok_1", reference: "order-o-1" });
+    expect(events.map((e) => e.type)).toEqual(["order.paid"]);
+  });
+
+  test("retries a timeout and a 503, then marks the order paid", async () => {
+    const { orders, calls } = fakeOrders(pending());
+    const { gateway, requests } = fakeGateway(["timeout", "unavailable", "ok"]);
+    const result = await captureOrder({ orders, gateway, audit: fakeAudit().audit, config, wait: noWait }, "o-1");
+    expect(result).toEqual({ status: "paid", chargeId: "ch_3" });
+    expect(requests).toHaveLength(3);
+    expect(calls).toEqual(["capturing", "paid ch_3"]);
+  });
+
+  test("marks a declined card and does not retry it", async () => {
+    const { orders, calls } = fakeOrders(pending());
+    const { gateway, requests } = fakeGateway(["decline"]);
+    const { audit, events } = fakeAudit();
+    const result = await captureOrder({ orders, gateway, audit, config, wait: noWait }, "o-1");
+    expect(result).toEqual({ status: "declined", code: "insufficient_funds" });
+    expect(requests).toHaveLength(1);
+    expect(calls).toEqual(["capturing", "declined insufficient_funds"]);
+    expect(events.map((e) => e.type)).toEqual(["order.declined"]);
+  });
+
+  test("gives the order back after the last failed attempt", async () => {
+    const { orders, calls } = fakeOrders(pending());
+    const { gateway, requests } = fakeGateway(["timeout", "timeout", "timeout"]);
+    const run = captureOrder({ orders, gateway, audit: fakeAudit().audit, config, wait: noWait }, "o-1");
+    await expect(run).rejects.toBeInstanceOf(GatewayTimeout);
+    expect(requests).toHaveLength(3);
+    expect(calls).toEqual(["capturing", "release"]);
+  });
+
+  test("skips an order that is not pending", async () => {
+    const order = { ...pending(), status: "paid" as const };
+    const { orders, calls } = fakeOrders(order);
+    const { gateway, requests } = fakeGateway([]);
+    const result = await captureOrder({ orders, gateway, audit: fakeAudit().audit, config, wait: noWait }, "o-1");
+    expect(result).toEqual({ status: "skipped" });
+    expect(requests).toHaveLength(0);
+    expect(calls).toEqual([]);
+  });
+});
diff --git a/tests/payments/retry.test.ts b/tests/payments/retry.test.ts
new file mode 100644
index 0000000..b148e6d
--- /dev/null
+++ b/tests/payments/retry.test.ts
@@ -0,0 +1,86 @@
+import { describe, expect, test } from "bun:test";
+import { retry } from "../../src/payments/retry";
+
+class Flaky extends Error {}
+class Fatal extends Error {}
+
+const policy = { maxAttempts: 4, baseDelayMs: 100 };
+const isFlaky = (e: unknown) => e instanceof Flaky;
+
+function recorder() {
+  const waits: number[] = [];
+  return { waits, wait: async (ms: number) => void waits.push(ms) };
+}
+
+describe("retry", () => {
+  test("returns the first result without a wait", async () => {
+    const r = recorder();
+    expect(await retry(async () => 7, policy, isFlaky, r.wait)).toBe(7);
+    expect(r.waits).toEqual([]);
+  });
+
+  test("retries a retryable error and doubles the wait", async () => {
+    const r = recorder();
+    let calls = 0;
+    const value = await retry(
+      async () => {
+        calls++;
+        if (calls < 4) throw new Flaky("try again");
+        return "done";
+      },
+      policy,
+      isFlaky,
+      r.wait,
+    );
+    expect(value).toBe("done");
+    expect(calls).toBe(4);
+    expect(r.waits).toEqual([100, 200, 400]);
+  });
+
+  test("throws the last error after maxAttempts", async () => {
+    const r = recorder();
+    let calls = 0;
+    const run = retry(
+      async () => {
+        calls++;
+        throw new Flaky(`attempt ${calls}`);
+      },
+      policy,
+      isFlaky,
+      r.wait,
+    );
+    await expect(run).rejects.toThrow("attempt 4");
+    expect(calls).toBe(4);
+  });
+
+  test("does not retry an error that retryable() refuses", async () => {
+    const r = recorder();
+    let calls = 0;
+    const run = retry(
+      async () => {
+        calls++;
+        throw new Fatal("no");
+      },
+      policy,
+      isFlaky,
+      r.wait,
+    );
+    await expect(run).rejects.toBeInstanceOf(Fatal);
+    expect(calls).toBe(1);
+    expect(r.waits).toEqual([]);
+  });
+
+  test("passes the attempt number to fn", async () => {
+    const seen: number[] = [];
+    await retry(
+      async (attempt) => {
+        seen.push(attempt);
+        if (attempt < 3) throw new Flaky("again");
+      },
+      policy,
+      isFlaky,
+      recorder().wait,
+    );
+    expect(seen).toEqual([1, 2, 3]);
+  });
+});
