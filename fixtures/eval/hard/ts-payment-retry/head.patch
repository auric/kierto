@@ -0,0 +1,48 @@
+import { randomUUID } from "node:crypto";
+import type { AuditLog } from "../audit";
+import type { Config } from "../config";
+import type { OrderRepo } from "../orders/repo";
+import { CardDeclined, type Gateway, GatewayTimeout, GatewayUnavailable } from "./gateway";
+import { retry, type Sleep, sleep } from "./retry";
+
+export type CaptureDeps = { orders: OrderRepo; gateway: Gateway; audit: AuditLog; config: Config; wait?: Sleep };
+
+export type CaptureResult = { status: "paid"; chargeId: string } | { status: "declined"; code: string } | { status: "skipped" };
+
+// A timeout or a 502, 503, or 504 answer is worth another attempt. Any other error is not.
+export const retryable = (e: unknown): boolean => e instanceof GatewayTimeout || e instanceof GatewayUnavailable;
+
+// Charges the total of a pending order. The capture-order job calls it, and several worker processes run jobs at once.
+export async function captureOrder(deps: CaptureDeps, orderId: string): Promise<CaptureResult> {
+  const order = await deps.orders.get(orderId);
+  if (order.status !== "pending") return { status: "skipped" };
+  await deps.orders.markCapturing(order.id);
+
+  try {
+    const charge = await retry(
+      () =>
+        deps.gateway.charge({
+          amountCents: order.totalCents,
+          currency: order.currency,
+          cardToken: order.cardToken,
+          reference: `order-${order.id}`,
+          idempotencyKey: randomUUID(),
+        }),
+      deps.config.payments.retry,
+      retryable,
+      deps.wait ?? sleep,
+    );
+    await deps.orders.markPaid(order.id, charge.chargeId);
+    void deps.audit.record({ type: "order.paid", orderId: order.id, chargeId: charge.chargeId, amountCents: order.totalCents });
+    return { status: "paid", chargeId: charge.chargeId };
+  } catch (e) {
+    if (e instanceof CardDeclined) {
+      await deps.orders.markDeclined(order.id, e.code);
+      void deps.audit.record({ type: "order.declined", orderId: order.id, code: e.code });
+      return { status: "declined", code: e.code };
+    }
+    // The job runs again later and finds the order pending.
+    await deps.orders.release(order.id);
+    throw e;
+  }
+}
diff --git a/src/payments/retry.ts b/src/payments/retry.ts
