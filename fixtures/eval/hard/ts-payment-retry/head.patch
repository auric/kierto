index 0000000..3729c5c
--- /dev/null
+++ b/src/payments/retry.ts
@@ -0,0 +1,23 @@
+import type { RetryPolicy } from "../config";
+
+export type Sleep = (ms: number) => Promise<void>;
+
+export const sleep: Sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+// Runs fn up to policy.maxAttempts times. Only errors that retryable() accepts get another attempt. The wait before the
+// second attempt is baseDelayMs, and each later wait doubles.
+export async function retry<T>(
+  fn: (attempt: number) => Promise<T>,
+  policy: RetryPolicy,
+  retryable: (e: unknown) => boolean,
+  wait: Sleep = sleep,
+): Promise<T> {
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await fn(attempt);
+    } catch (e) {
+      if (attempt >= policy.maxAttempts || !retryable(e)) throw e;
+      await wait(policy.baseDelayMs * 2 ** (attempt - 1));
+    }
+  }
+}
