+// Adds the manifest entries in file order. An entry with an extends name inherits the flags and the dependencies of that
+// entry, which the index or an earlier manifest line must define.
 IndexError applyManifest(const std::vector<ManifestLine>& lines, Registry& reg, std::vector<std::string>& errors) {
   for (const ManifestLine& m : lines) {
-    if (m.fields[3] != "-") {
-      errors.push_back(m.fields[0] + ": extends is not supported yet");
-      continue;
+    const std::string& name = m.fields[0];
+    const std::string& path = m.fields[1];
+    const auto flags = static_cast<std::uint32_t>(std::stoul(m.fields[2], nullptr, 16));
+    const std::string& extends = m.fields[3];
+
+    const Entry* base = nullptr;
+    if (extends != "-") {
+      base = reg.find(extends);
+      if (!base) {
+        errors.push_back(name + ": unknown base " + extends + at(m));
+        continue;
+      }
     }
     Entry e;
-    e.name = m.fields[0];
-    e.path = m.fields[1];
-    e.flags = static_cast<std::uint32_t>(std::stoul(m.fields[2], nullptr, 16));
-    if (!reg.add(std::move(e))) errors.push_back(m.fields[0] + ": defined twice");
+    e.name = name;
+    e.path = path;
+    e.flags = flags;
+    if (!reg.add(std::move(e))) {
+      errors.push_back(name + ": defined twice" + at(m));
+      continue;
+    }
+    if (base) reg.inherit(name, *base);
   }
   return errors.empty() ? IndexError::kOk : IndexError::kManifest;
 }
