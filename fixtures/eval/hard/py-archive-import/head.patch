@@ -25,17 +37,52 @@ def _row(fields: list[str], line: int) -> tuple[str, Decimal, str]:
     return account, value, booked_on
 
 
+def _wait_for_lock(conn) -> None:
+    deadline = time.monotonic() + settings.LEDGER_LOCK_TIMEOUT
+    while not db.try_lock(conn, db.LEDGER_LOCK):
+        if time.monotonic() > deadline:
+            raise LockTimeout("the ledger lock is busy")
+        time.sleep(0.5)
+
+
+def _archive_path(batch: str) -> Path:
+    day = settings.ARCHIVE_ROOT / time.strftime("%Y-%m-%d")
+    day.mkdir(parents=True, exist_ok=True)
+    return day / f"{batch}.csv"
+
+
 def import_file(path: Path, conn) -> int:
-    """Inserts the rows of a claimed file of format version 1 (no header, EUR only) and moves it to the done folder."""
-    batch = path.name.split(".")[0]
+    """Inserts the rows of a claimed file of format version 2 and moves the file into the archive of the day."""
     with path.open(newline="", encoding="utf-8") as f:
-        rows = [_row(fields, n) for n, fields in enumerate(csv.reader(f), start=1)]
-    with conn.cursor() as cur:
-        cur.executemany(
-            "INSERT INTO ledger_eur (batch, account, amount, booked_on) VALUES (%s, %s, %s, %s)",
-            [(batch, *r) for r in rows],
-        )
-    conn.commit()
-    path.rename(settings.DONE_DIR / f"{batch}.csv")
-    log.info("imported %s: %d rows", batch, len(rows))
+        try:
+            header = read_header(f)
+        except BadHeader as e:
+            raise ImportRejected(str(e)) from None
+        if header.rows > settings.MAX_ROWS:
+            raise ImportRejected(f"{header.rows} rows is above the limit of {settings.MAX_ROWS}")
+        rows = [_row(fields, n) for n, fields in enumerate(csv.reader(f), start=2)]
+    if len(rows) != header.rows:
+        raise ImportRejected(f"the header says {header.rows} rows, the file has {len(rows)}")
+
+    dest = _archive_path(header.batch)
+    if dest.exists():
+        raise ArchiveExists(f"batch {header.batch} is archived today already")
+
+    table = TABLE_BY_CURRENCY[header.currency]
+    _wait_for_lock(conn)
+    try:
+        with conn.cursor() as cur:
+            cur.executemany(
+                f"INSERT INTO {table} (batch, account, amount, booked_on) VALUES (%s, %s, %s, %s)",
+                [(header.batch, *r) for r in rows],
+            )
+        conn.commit()
+    except BaseException:
+        conn.rollback()
+        raise
+    finally:
+        db.unlock(conn, db.LEDGER_LOCK)
+
+    os.rename(path, dest)
+    log.info("imported %s into %s: %d rows, archived as %s", header.batch, table, len(rows), dest)
     return len(rows)
