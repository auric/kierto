 log = logging.getLogger(__name__)
 
@@ -14,6 +18,14 @@ class ImportRejected(Exception):
     """The file breaks a rule. The scheduler moves it to the rejected folder."""
 
 
+class ArchiveExists(ImportRejected):
+    """A batch of this name is archived today already. The archive is the audit copy, so nothing replaces it."""
+
+
+class LockTimeout(Exception):
+    """Another writer held the ledger lock too long. The scheduler puts the file back for the next round."""
